# Virtual envs
env/
venv/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Old root-level standalone scripts — must be excluded so Vercel
# doesn't auto-detect them instead of api/index.py
app.py
app2.py
app copy.py
ashutosh.py
ex2.py
test*.py

# Generated files (built at runtime in /tmp on Vercel)
app/static/generated/
generated_ppts/
output/
*.pptx
*.mp4

# Screenshots (large PNGs, not needed at runtime)
screenshots/

# Secrets
.env
